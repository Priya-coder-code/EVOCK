# ==============================================================================
# EVOCK Local Bridge Configuration (.env)
#
# Copy this file to .env in the bridge/ directory, then start the bridge:
#   cp bridge/.env.example bridge/.env
#   cd bridge && npm start          # Node >= 18, no npm install needed
#
# DO NOT commit bridge/.env to Git! It contains your private OpenRouter API key.
# ==============================================================================

# Required: Your OpenRouter API key (from https://openrouter.ai/keys)
# Put the real key only in bridge/.env (git-ignored) — never in this example file.
OPENROUTER_API_KEY=

# Optional: Vision-Language Model ID
# Must support multimodal image input.
# Examples:
#   qwen/qwen3-vl-30b-a3b-instruct
#   google/gemini-2.5-flash
#   anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# Optional: Bridge Server Configuration
# BRIDGE_HOST is always forced to loopback; a public/wildcard value is refused.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# Optional: pin CORS to exactly one extension origin instead of allowing any
# chrome-extension:// origin. Find your id at chrome://extensions.
#   ALLOWED_ORIGIN=chrome-extension://abcdefghijklmnopabcdefghijklmnop
